local function getRightmostMonitorHeight(fallback)
    local handle = io.popen([[
        kscreen-doctor -j 2>/dev/null | jq -r '
            [.outputs[] | select(.connected and .enabled)]
            | max_by(.pos.x)
            | .size.height // empty
        '
    ]])

    if not handle then
        return fallback
    end

    local height = tonumber(handle:read("*a"))
    handle:close()

    if height and height > 0 then
        return math.floor(height + 0.5)
    end

    return fallback
end
local height = getRightmostMonitorHeight(1440)

