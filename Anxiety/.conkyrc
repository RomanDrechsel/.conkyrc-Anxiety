local configPath = debug.getinfo(1, "S").source:sub(2)
local handle = assert(io.popen("dirname \"$(readlink -f " .. string.format("%q", configPath) .. ")\""))
local root = handle:read("*l")
handle:close()

assert(root and root ~= "", "Unable to resolve configuration directory")
dofile(root .. "/lua/helpers/init_functions.lua")
local monitor = GetRightmostMonitor()
local geometry = GetAvailableScreenGeometry(monitor)
local height = geometry and geometry.Height or 1440


